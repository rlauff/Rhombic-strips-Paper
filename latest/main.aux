\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces An unsplittable (non-cyclic) rhombic strip in the plane. The orange rhombi are blocked, because none of their edges lead to a rhombus of higher rank. The green rhombi are blocked because all their edges either lead to a rhombus of the same or smaller rank, or to an already blocked rhombus. By identifying (glueing) $A,B$ and $C$, we obtain an atomic cyclic rhombic strip.}}{34}{figure.caption.39}\protected@file@percent }
\newlabel{fig:atomic plane}{{30}{34}{An unsplittable (non-cyclic) rhombic strip in the plane. The orange rhombi are blocked, because none of their edges lead to a rhombus of higher rank. The green rhombi are blocked because all their edges either lead to a rhombus of the same or smaller rank, or to an already blocked rhombus. By identifying (glueing) $A,B$ and $C$, we obtain an atomic cyclic rhombic strip}{figure.caption.39}{}}
\newlabel{fig:atomic plane@cref}{{[figure][30][]30}{[1][33][]34}{}{}{}}
